# URL of the private EVM node WebSocket endpoint.
# This value is ONLY read by the backend server and is never sent to the browser.
TEZOS_WS_URL=ws://127.0.0.1:8545/ws

# Port the broadcast server will listen on (default: 3001)
PORT=3001

# How long to wait (in milliseconds) before retrying a dropped upstream
# EVM node connection (default: 3000)
RECONNECT_DELAY_MS=3000

# Comma-separated list of browser origins that are allowed to connect.
# Leave commented out to allow all origins (convenient for local development).
# ALLOWED_ORIGINS=http://localhost:8080,https://stream.proofofspeed.xyz
