# Private EVM node WebSocket URL.
# Used by the Node.js server (never exposed to browsers).
TEZOS_WS_URL=wss://your-evm-node.example.com

# How long to wait before retrying a dropped upstream EVM connection (ms).
# Default: 3000
# RECONNECT_DELAY_MS=3000

# Optional: comma-separated list of browser origins allowed to connect.
# Leave unset to allow all origins (useful during local development).
# ALLOWED_ORIGINS=https://your-frontend.run.app

# Development only: override the WS URL used by the frontend.
# In production the server and frontend share the same host/port so this
# is not needed.
# VITE_WS_BACKEND_URL=ws://localhost:8080
